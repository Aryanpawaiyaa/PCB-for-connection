# main.ato
# DroneX Battery Carrier PCB Entry Point
# This file instantiates the mechanical, electrical, and routing parameters,
# and implements the high-current distribution network mapping 6 x XT30 inputs to 1 x XT90 output.

import Board from "board.ato"
import Stackup from "stackup.ato"
import Rules from "rules.ato"
import Mounting from "mounting.ato"
import XT30 from "connectors.ato"
import XT90 from "connectors.ato"
import Silkscreen from "silkscreen.ato"
import Power from "power.ato"

module DroneX_Battery_Carrier:
    # 1. Instantiate Mechanical Board Outline configuration
    board = new Board

    # 2. Instantiate 4-layer Stackup configuration
    stackup = new Stackup

    # 3. Instantiate Design Rules & DRC constraints
    rules = new Rules

    # 4. Instantiate Silkscreen & Polarity documentation properties
    silkscreen = new Silkscreen

    # 5. Instantiate Mounting Hole layout (automatically instantiates 4 x M3 holes)
    mounting = new Mounting

    # 6. Instantiate Power Net definition & constraints module
    power = new Power

    # 7. Instantiate 6 x XT30 Input Connectors for battery modules
    xt30_1 = new XT30
    xt30_2 = new XT30
    xt30_3 = new XT30
    xt30_4 = new XT30
    xt30_5 = new XT30
    xt30_6 = new XT30

    # 8. Instantiate 1 x XT90 Output Connector for power distribution / ESC load
    xt90 = new XT90

    # 9. Establish Power Distribution Network (Parallel bus configuration)
    # Connect all Negative terminals (pin p1) to the abstract Ground net
    xt30_1.p1 ~ power.GND
    xt30_2.p1 ~ power.GND
    xt30_3.p1 ~ power.GND
    xt30_4.p1 ~ power.GND
    xt30_5.p1 ~ power.GND
    xt30_6.p1 ~ power.GND
    xt90.p1   ~ power.GND

    # Connect all Positive terminals (pin p2) to the abstract V_BAT net
    xt30_1.p2 ~ power.V_BAT
    xt30_2.p2 ~ power.V_BAT
    xt30_3.p2 ~ power.V_BAT
    xt30_4.p2 ~ power.V_BAT
    xt30_5.p2 ~ power.V_BAT
    xt30_6.p2 ~ power.V_BAT
    xt90.p2   ~ power.V_BAT
