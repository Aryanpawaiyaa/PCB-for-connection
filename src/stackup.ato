# stackup.ato
# This file defines the 4-layer PCB stackup parameters.
# Outer layers (Top/Bottom) use 2 oz copper for high current capacity.
# Inner layers (In1/In2) use 1 oz copper for ground and power distribution.

module Stackup:
    layers = 4
    material = "FR4"
    total_thickness = 1.6mm

    # Copper weight configuration
    outer_copper = 2oz
    inner_copper = 1oz

    # Layer mapping for manufacturing documentation
    layer_1 = "Top Copper (2 oz, Signal/Power)"
    layer_2 = "Inner 1 (1 oz, Solid Ground Plane)"
    layer_3 = "Inner 2 (1 oz, Power Plane/Bus)"
    layer_4 = "Bottom Copper (2 oz, Signal/Power)"
