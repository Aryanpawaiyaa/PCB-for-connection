# connectors.ato
# This file defines the components for high-current AMASS XT30 and XT90 connectors.
# p1 corresponds to PIN 1 (GND / Negative terminal, flat side).
# p2 corresponds to PIN 2 (V_BAT / Positive terminal, round side).

component XT30:
    pin p1
    pin p2
    
    # Map logical pins to physical footprint pads 1 and 2
    p1 ~ pin 1
    p2 ~ pin 2

    footprint = "Connector_AMASS:AMASS_XT30U-M_1x02_P5.0mm_Vertical"
    designator_prefix = "J"
    # mpn and manufacturer are commented out to prevent online part picking in this environment
    # mpn = "XT30U-M"
    # manufacturer = "AMASS"
    exclude_from_bom = True

component XT90:
    pin p1
    pin p2
    
    # Map logical pins to physical footprint pads 1 and 2
    p1 ~ pin 1
    p2 ~ pin 2

    footprint = "Connector_AMASS:AMASS_XT90PW-M_1x02_P10.90mm_Horizontal"
    designator_prefix = "J"
    # mpn and manufacturer are commented out to prevent online part picking in this environment
    # mpn = "XT90PW-M"
    # manufacturer = "AMASS"
    exclude_from_bom = True
